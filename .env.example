# ===== 数据库 =====
# MySQL 连接字符串（密码部分从 MYSQL_PASSWORD 读取）
DATABASE_URL=mysql+pymysql://sework:${MYSQL_PASSWORD}@127.0.0.1:3307/sework

# MySQL 容器密码（需与 docker-compose.yml 中保持一致）
MYSQL_PASSWORD=your_mysql_password_here
MYSQL_ROOT_PASSWORD=your_root_password_here

# ===== 应用密钥 =====
# Flask SECRET_KEY（请使用随机字符串，建议 32+ 字符）
SECRET_KEY=change-this-to-a-random-secret-key

# ===== LLM（可选） =====
# 智谱 AI API Key（用于 AI 助手功能，不配置则走规则化回退）
ZHIPU_API_KEY=your_zhipu_api_key_here
ZHIPU_MODEL=glm-4-flash
ZHIPU_API_URL=https://open.bigmodel.cn/api/paas/v4

# ===== 向量检索服务 =====
# FAISS HTTP 服务地址（本地开发用 docker-compose 启动的 faiss 服务）
FAISS_SERVICE_URL=http://127.0.0.1:8001

# ===== 项目路径（可选） =====
# FAISS 服务索引根目录（默认 knowledge/index）
FAISS_INDEX_PATH=knowledge/index

# 知识库索引目录（默认 knowledge/index）
SEWORK_KNOWLEDGE_INDEX_DIR=knowledge/index

# 用户扩展知识库路径（多个路径用英文分号分隔）
# SEWORK_USER_KB_PATHS=knowledge/source/user;data/kb/user
